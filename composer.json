{
    "name": "heimrichhannot/contao-media-library-bundle",
    "type": "contao-bundle",
    "description": "Add a Media Library to your Contao CMS Web Application.",
    "license": "LGPL-3.0-or-later",
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^4.13 || ^5.3",
        "heimrichhannot/contao-flare-bundle": "0.1.*",
        "heimrichhannot/contao-form-type-bundle": "^0.2.0",
        "heimrichhannot/contao-utils-bundle": "^2.220 || ^3.0",
        "symfony/config": "^5.4 || ^6.4",
        "symfony/event-dispatcher-contracts": "^1.0 || ^2.0 || ^3.0",
        "symfony/translation-contracts": "^1.0 || ^2.0 || ^3.0",
        "ausi/slug-generator": "^1.0"
    },
    "conflict": {
        "heimrichhannot/contao-filecredits-bundle": "<2.1.0",
        "heimrichhannot/contao-flare-bundle": "<0.0.29"
    },
    "suggest": {
        "codefog/tags-bundle": "^3.2",
        "heimrichhannot/contao-categories-bundle": "^1.1",
        "heimrichhannot/contao-filecredits-bundle": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "HeimrichHannot\\MediaLibraryBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "HeimrichHannot\\MediaLibraryBundle\\ContaoManager\\Plugin"
    }
}